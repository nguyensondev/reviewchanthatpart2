# Copy file nay thanh `.env` va dien cac khoa RIENG cho kenh #2 (KHONG commit file `.env` len Git)
# Luu y: Dung GEMINI_API_KEY rieng & TELEGRAM_BOT_TOKEN rieng (@BotFather) de 2 kenh khong tranh quota/getUpdates!
GEMINI_API_KEYS=your_separate_gemini_api_key_here
GEMINI_API_KEY=your_separate_gemini_api_key_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_SUBDOMAIN=gocreviewchanthuc
CLOUDFLARE_WORKER_NAME=giadung
TELEGRAM_BOT_TOKEN=your_new_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
CHANNEL_COVER_HEADER_VI=NHÀ CÓ ĐỒ HAY  •  CHÍNH HÃNG
